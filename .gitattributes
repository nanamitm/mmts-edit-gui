# Normalize line endings: text files use LF in the repo.
* text=auto eol=lf

# Windows scripts keep CRLF.
*.bat text eol=crlf
*.ps1 text eol=crlf

# Treat common binaries as binary (no EOL conversion / diff).
*.png binary
*.jpg binary
*.zip binary
*.ax  binary
*.dll binary
*.lib binary
*.mmts binary
*.mmtsmap binary
