// properties.
VS_VERSION_INFO VERSIONINFO
 FILEVERSION MMTS_EDIT_VERSION_NUMBERS
 PRODUCTVERSION MMTS_EDIT_VERSION_NUMBERS
 FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
 FILEFLAGS 0x0L
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
