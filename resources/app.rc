        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "MMTS Edit GUI"
            VALUE "FileVersion", MMTS_EDIT_VERSION_STRING
            VALUE "ProductName", "mmts-edit-gui"
            VALUE "ProductVersion", MMTS_EDIT_VERSION_STRING
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
